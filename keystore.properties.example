# Copiaza acest fisier ca "keystore.properties" (in aceeasi radacina) si completeaza valorile.
# keystore.properties NU se urca in git (e in .gitignore) - contine parolele cheii de semnare.
#
# Foloseste SLASH-uri normale (/) in cale, chiar si pe Windows, nu backslash.
# Calea poate fi absoluta (recomandat: pastreaza cheia IN AFARA folderului proiectului)
# sau relativa la radacina proiectului.
storeFile=D:/keys/sportspulse-upload.jks
storePassword=PAROLA_KEYSTORE
keyAlias=upload
keyPassword=PAROLA_CHEIE
